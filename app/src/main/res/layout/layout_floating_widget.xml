<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Sub Menu -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutSubMenu"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="72dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E61A1A2E"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/btnRealtime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:text="@string/realtime"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.example.screentranslator.KlipManualButton
                android:id="@+id/btnManual"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:text="@string/klip"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/secondary"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.example.screentranslator.KlipCancelButton
                android:id="@+id/btnRemoveOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:text="@string/cancel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_error"
                android:backgroundTint="@color/error"
                android:visibility="gone"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/exit"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface_variant"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMain"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="@string/manual_tl"
        app:fabCustomSize="56dp"
        app:backgroundTint="@color/primary"
        app:tint="@color/on_primary"
        app:srcCompat="@android:drawable/ic_menu_compass"
        app:elevation="8dp"
        app:pressedTranslationZ="12dp" />

</FrameLayout>
