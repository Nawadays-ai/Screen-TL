<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutSubMenu"
        android:layout_width="156dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E61E1E1E"
        android:padding="6dp"
        android:visibility="gone"
        android:elevation="8dp"
        android:layout_gravity="center_vertical"
        android:translationX="56dp">

        <Button
            android:id="@+id/btnRealtime"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="▶ Real-Time"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="🔍 Manual TL"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnRemoveOverlay"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="✕ Hapus Overlay"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="✖ Keluar"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F44336" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMain"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:alpha="0.75"
        android:contentDescription="Translator Button"
        app:fabCustomSize="48dp"
        app:backgroundTint="#2196F3"
        app:tint="#FFFFFF"
        app:srcCompat="@android:drawable/ic_menu_compass" />

</FrameLayout>
