<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnBackPerformance"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_icon_background"
            android:contentDescription="@string/performance"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/on_surface_variant"
            android:padding="10dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Log Performa"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Clear Button -->
    <Button
        android:id="@+id/btnClearPerformance"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        style="@style/Widget.ScreenTranslator.Button.Secondary"
        android:text="Hapus Log" />

    <!-- Performance Content -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        style="@style/Widget.ScreenTranslator.Card">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvPerformance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textIsSelectable="true" />
        </ScrollView>
    </androidx.cardview.widget.CardView>
</LinearLayout>
