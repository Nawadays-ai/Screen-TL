<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnBackSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="22sp"
                android:contentDescription="Kembali" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mesin Translation Manual"
            android:textColor="#BBBBBB" />
        <Spinner
            android:id="@+id/spinnerManualProvider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#2A2A2A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="API sendiri — Gemini"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Key disimpan terenkripsi di perangkat."
            android:textColor="#888888"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etGeminiKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Masukkan API key"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:inputType="textPassword"
            android:singleLine="true" />
        <TextView
            android:id="@+id/tvGeminiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BBBBBB"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnGeminiCheck"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Cek"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/btnGeminiUse"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Gunakan"
                android:textAllCaps="false" />
        </LinearLayout>
        <Button
            android:id="@+id/btnGeminiDisable"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Nonaktifkan"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="DeepL API"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etDeepLKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Masukkan DeepL API key"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:inputType="textPassword"
            android:singleLine="true" />
        <TextView
            android:id="@+id/tvDeepLStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BBBBBB"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnDeepLCheck"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Cek"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/btnDeepLUse"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Gunakan"
                android:textAllCaps="false" />
        </LinearLayout>
        <Button
            android:id="@+id/btnDeepLDisable"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Nonaktifkan"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="Gemini aktif akan dipakai sebagai API sendiri dan mengambil prioritas dari pilihan mesin manual. Untuk DeepL, pilih DeepL API pada menu di atas setelah API-nya diaktifkan."
            android:textColor="#777777"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
